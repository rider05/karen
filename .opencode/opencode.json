{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "karen-orchestrator",
  "instructions": ["AGENTS.md", "docs/DESIGN.md"],
  "permissions": [
    {
      "action": "read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ]
}
